<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishTrimmed>false</PublishTrimmed>
    <WasmEnableHotReload>false</WasmEnableHotReload>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RunAOTCompilation>false</RunAOTCompilation>
    <WasmBuildNative>false</WasmBuildNative>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="verification/**" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.15" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
  </ItemGroup>
  <!-- Core MSBuild can run these compatible tasks in-process. Avoid a task-host
       IPC startup failure in restricted Linux build containers. -->
  <UsingTask TaskName="Microsoft.NET.Sdk.WebAssembly.ComputeWasmBuildAssets" AssemblyFile="$(NuGetPackageRoot)microsoft.net.sdk.webassembly.pack/10.0.15/tools/net10.0/Microsoft.NET.Sdk.WebAssembly.Pack.Tasks.dll" Override="true" Condition="'$(MSBuildRuntimeType)' == 'Core'" />
  <UsingTask TaskName="Microsoft.NET.Sdk.WebAssembly.ComputeWasmPublishAssets" AssemblyFile="$(NuGetPackageRoot)microsoft.net.sdk.webassembly.pack/10.0.15/tools/net10.0/Microsoft.NET.Sdk.WebAssembly.Pack.Tasks.dll" Override="true" Condition="'$(MSBuildRuntimeType)' == 'Core'" />
  <UsingTask TaskName="Microsoft.NET.Sdk.WebAssembly.GenerateWasmBootJson" AssemblyFile="$(NuGetPackageRoot)microsoft.net.sdk.webassembly.pack/10.0.15/tools/net10.0/Microsoft.NET.Sdk.WebAssembly.Pack.Tasks.dll" Override="true" Condition="'$(MSBuildRuntimeType)' == 'Core'" />
  <UsingTask TaskName="Microsoft.NET.Sdk.WebAssembly.ConvertDllsToWebCil" AssemblyFile="$(NuGetPackageRoot)microsoft.net.sdk.webassembly.pack/10.0.15/tools/net10.0/Microsoft.NET.Sdk.WebAssembly.Pack.Tasks.dll" Override="true" Condition="'$(MSBuildRuntimeType)' == 'Core'" />
</Project>
